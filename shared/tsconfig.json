{
  "compilerOptions": {
    "target": "ES2022",
    // No DOM, deliberately. Nothing here may reach for a browser global: the
    // one place that wants Web Storage goes through `globalThis` and a local
    // interface instead. Adding DOM back would let react-shaped code drift in
    // and would break the headless consumers that typecheck this source.
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    // The test fixtures import example/data/*.json.
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}
