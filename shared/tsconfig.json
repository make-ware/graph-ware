{
  "compilerOptions": {
    "target": "ES2022",
    // DOM is here for exactly two reasons: `services/auth.ts` sweeps
    // `localStorage` behind a `typeof window` guard, and `lib/client.ts` uses
    // `AbortController`. The package must otherwise stay headless — no react,
    // no next, no `'use client'`.
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    // The test fixtures import example/data/*.json.
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}
