{
  "name": "graph-ware",
  "version": "0.0.0",
  "private": true,
  "packageManager": "yarn@4.12.0",
  "workspaces": [
    "webapp",
    "pocketbase"
  ],
  "scripts": {
    "init:project": "node scripts/init-project.js",
    "setup": "node scripts/setup-pocketbase.js",
    "dev": "concurrently \"yarn workspace @project/webapp dev\" \"yarn workspace @project/pb dev\"",
    "build": "yarn workspaces foreach -A run build",
    "test": "yarn workspace @project/webapp test",
    "test:watch": "concurrently  \"yarn workspace @project/webapp test:watch\"",
    "lint:check": "yarn workspaces foreach -A run lint",
    "lint": "yarn workspaces foreach -A run lint:fix",
    "typecheck": "yarn workspaces foreach -A run typecheck",
    "format": "yarn workspaces foreach -A run format",
    "format:check": "yarn workspaces foreach -A run format:check",
    "clean": "yarn workspaces foreach -R run clean && rm -rf pocketbase/pocketbase",
    "db:status": "NODE_OPTIONS=\"--import tsx\" pocketbase-migrate status",
    "db:verify": "NODE_OPTIONS=\"--import tsx\" pocketbase-migrate status --verify",
    "db:generate": "NODE_OPTIONS=\"--import tsx\" pocketbase-migrate generate",
    "db:lint": "NODE_OPTIONS=\"--import tsx\" pocketbase-migrate lint",
    "db:seed": "node scripts/seed-graphs.mjs",
    "typegen": "NODE_OPTIONS=\"--import tsx\" pocketbase-migrate generate-types",
    "precommit": "yarn run lint && yarn run typecheck && yarn run format && yarn run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "concurrently": "^9.2.4",
    "eslint": "^9.39.5",
    "pocketbase-zod-schema": "^1.0.2",
    "prettier": "^3.9.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
