# PocketBase server (binary) version — the single source of truth. The setup
# script and Docker/CI builds all read this value; bump it here to upgrade.
POCKETBASE_VERSION=0.39.9

# Webapp client — base URL the browser uses to reach the PocketBase API.
# In Docker (single image, nginx proxy on :80) this is the same origin: leave blank
# or set to /api. For local dev, point at the standalone PocketBase port.
NEXT_PUBLIC_POCKETBASE_URL=http://localhost:8090

# PocketBase superuser, for Docker deploys: when both EMAIL and PASSWORD are
# passed to the container, the entrypoint auto-creates this superuser on boot
# (idempotent upsert). Leave them unset to keep PocketBase's default — a one-time
# setup URL is printed to the logs on first boot.
#
# The migration scripts (yarn db:status / db:generate / db:verify) need none of
# this: they read the schemas, pocketbase/pb_migrations, and pocketbase/pb_data
# from disk rather than authenticating against a running server.
POCKETBASE_ADMIN_EMAIL=admin@example.com
POCKETBASE_ADMIN_PASSWORD=change-me

NODE_ENV=development
